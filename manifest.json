{
  "manifest_version": 2,
  "name": "Kyara Boosters",
  "version": "1.0.0",
  "description": "Suit les boosters gratuits de kyara.games et prévient quand le stock approche du maximum, seulement après vérification du vrai chiffre.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kyara-boosters@izoukusenpai",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "idle",
    "https://kyara.games/*"
  ],
  "background": {
    "scripts": ["logic.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://kyara.games/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Kyara Boosters",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  }
}
